{
  "model": {
    "max_seq_length": 256,
    "embed_dim": 64,
    "hidden_dim": 128,
    "n_steps": 5,
    "n_d": 64,
    "n_a": 64,
    "gamma": 1.5,
    "n_shared": 2,
    "n_step": 2,
    "virtual_batch_size": 128,
    "pooling": "attention",
    "use_positional": true,
    "vocab_size": 320,
    "n_decoder_layers": 6
  },
  "training": {
    "task_type": "generation",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "batch_size": 16,
    "num_epochs": 100,
    "optimizer": "adamw",
    "sparsity_weight": 0.001,
    "label_smoothing": 0.1,
    "gradient_clip": 1.0,
    "lr_schedule": "warmup_cosine",
    "warmup_steps": 1000,
    "min_lr": 1e-06,
    "patience": 15,
    "min_delta": 0.0001,
    "save_every": 5,
    "checkpoint_dir": "./checkpoints/generation",
    "keep_best_k": 3,
    "log_every": 10,
    "eval_every": 200,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "shuffle_seed": 42
  },
  "data": {
    "data_path": "data/translation_data.parquet",
    "data_format": "parquet",
    "text_column": "source",
    "target_column": "target",
    "max_target_length": 256
  }
}
