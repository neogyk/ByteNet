{
  "model": {
    "max_seq_length": 512,
    "embed_dim": 64,
    "hidden_dim": 128,
    "n_steps": 5,
    "n_d": 64,
    "n_a": 64,
    "gamma": 1.5,
    "n_shared": 2,
    "n_step": 2,
    "virtual_batch_size": 128,
    "pooling": "attention",
    "use_positional": true,
    "vocab_size": 320
  },
  "training": {
    "task_type": "regression",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "batch_size": 32,
    "num_epochs": 100,
    "optimizer": "adamw",
    "sparsity_weight": 0.001,
    "label_smoothing": 0.0,
    "gradient_clip": 1.0,
    "lr_schedule": "warmup_cosine",
    "warmup_steps": 500,
    "min_lr": 1e-06,
    "patience": 10,
    "min_delta": 0.0001,
    "save_every": 5,
    "checkpoint_dir": "./checkpoints/regression",
    "keep_best_k": 3,
    "log_every": 10,
    "eval_every": 100,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "shuffle_seed": 42
  },
  "data": {
    "data_path": "data/regression_data.parquet",
    "data_format": "parquet",
    "text_column": "features",
    "label_column": "target_value",
    "parquet_columns": ["feature1", "feature2", "feature3"]
  }
}
